# Copy this file to .env and fill in your values. Never commit .env.

# --- Database ---
# Local MySQL / XAMPP:  DB_HOST=localhost  DB_PORT=3306  DB_SSL=false
# TiDB Cloud:           DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com  DB_PORT=4000  DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=allegation_portal
DB_SSL=false

# --- Auth ---
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Uploads (Cloudinary). Required on Vercel; optional locally ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Production only ---
# Your frontend URL(s), comma-separated, for CORS
FRONTEND_URL=https://public-allegation-portal-five.vercel.app
# Vercel Cron sends this as a Bearer token to /api/cron/purge
CRON_SECRET=another-long-random-string
